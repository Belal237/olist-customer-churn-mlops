# Copy to .env and adjust. Every variable is optional — defaults live in src/config.py.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=olist_db
POSTGRES_USER=olist_user
POSTGRES_PASSWORD=olist_pass

# Churn window (days without a delivered order after the cutoff date)
CHURN_DAYS=180

# MLflow
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=churn-prediction
REGISTERED_MODEL_NAME=churn-prediction
